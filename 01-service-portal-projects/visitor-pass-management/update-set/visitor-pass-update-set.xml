r.u_user_id = "VIS" + new GlideDateTime().getNumericValue(); gr.insert(); data.showCard = true; data.name = input.name; data.title = input.title; data.city = input.city; data.phone = input.phone; data.purpose = input.purpose; data.userid = gr.getValue("u_user_id"); data.date = new GlideDate().getDisplayValue(); } })();]]></script><servicenow>false</servicenow><sys_class_name>sp_widget</sys_class_name><sys_created_by>VSK</sys_created_by><sys_created_on>2026-07-27 14:23:46</sys_created_on><sys_id>0785091e8392431075dcc1d6feaad31e</sys_id><sys_mod_count>14</sys_mod_count><sys_name>Visitor Pass</sys_name><sys_package display_value="Global" source="global">global</sys_package><sys_policy/><sys_scope display_value="Global">global</sys_scope><sys_update_name>sp_widget_0785091e8392431075dcc1d6feaad31e</sys_update_name><sys_updated_by>VSK</sys_updated_by><sys_updated_on>2026-07-29 08:48:33</sys_updated_on><template><![CDATA[<div class="container"> <div class="row"> <div class="col-md-5"> <div class="panel panel-primary"> <div class="panel-heading"> <h3 class="text-center">Visitor Registration</h3> </div> <div class="panel-body"> <div class="form-group"> <label>Name</label> <input class="form-control" ng-model="c.data.name"> </div> <div class="form-group"> <label>Designation</label> <input class="form-control" ng-model="c.data.title"> </div> <div class="form-group"> <label>Mobile Number</label> <input class="form-control" ng-model="c.data.phone"> </div> <!-- Added because city/place is used in your scripts --> <div class="form-group"> <label>Place</label> <input class="form-control" ng-model="c.data.city"> </div> <div class="form-group"> <label>Purpose of Visit</label> <textarea class="form-control" ng-model="c.data.purpose"></textarea> </div> <button class="btn btn-success btn-block" ng-click="c.save()"> Generate Visitor Pass </button> </div> </div> </div> <div class="col-md-7" ng-if="c.data.showCard"> <div class="visitorcard"> <div class="header"> <h2>WELCOME TO VSK SOFTWARE